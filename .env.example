# Configuration locale uniquement. Sur Render, utiliser les secrets du service.
# Ne jamais transmettre de clé ou de mot de passe dans ChatGPT.
PORT=8787
PUBLIC_URL=http://localhost:8787
# Numéro du compte sur zotero.org/settings/keys (pas le nom du compte)
ZOTERO_USER_ID=
ZOTERO_API_KEY=
# Texte exact false ou true, sans guillemets
WRITE_ENABLED=false
# Secret de signature : au moins 32 caractères ; généré automatiquement sur Render
AUTH_SIGNING_SECRET=
# Mot de passe du connecteur : au moins 20 caractères ; différent de celui de Zotero
OWNER_PASSWORD=
# Paramètres publics déjà définis par défaut, sans secret client OAuth
OAUTH_CLIENT_ID=zotero-cloud-personal
OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
